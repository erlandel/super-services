---
import HeroCards from './HeroCards.astro';
---

<section
  class="hero relative min-h-screen grid grid-cols-[1.05fr_0.95fr] items-center gap-[60px] px-[6%] mt-10 pb-20 bg-surface overflow-hidden max-md:grid-cols-1 max-md:gap-[30px] max-md:pb-[100px] max-w-9xl"
>
  <div class="relative z-2 ">
    <div
      class="inline-flex items-center gap-2 text-[0.8rem] font-semibold tracking-[1.8px] uppercase text-blue mb-7 px-3.5 py-1.5 rounded-full bg-blue-light opacity-0 animate-up"
      data-i18n="hero.eyebrow"
      style="animation-delay: 0.1s"
    >
      Alexandria, Virginia
    </div>

    <h1
      class="font-display text-[clamp(3rem,5.5vw,4.8rem)] font-extrabold leading-[1.08] text-ink tracking-[-1px] opacity-0 animate-up"
      data-i18n-html="hero.title"
      style="animation-delay: 0.2s"
    >
      Your Multi-<em class="not-italic text-blue">Service</em><br />Solutions Hub.
    </h1>

    <p
      class="text-xl leading-[1.75] text-muted mt-6 max-w-[500px] opacity-0 animate-up"
      data-i18n="hero.desc"
      style="animation-delay: 0.3s"
    >
      Renewable solar energy, digital services, home appliances, and customer support — everything you need, all in one convenient location in Northern Virginia.
    </p>

    <div
      class="flex gap-3.5 mt-10 opacity-0 animate-up max-[480px]:gap-2.5"
      style="animation-delay: 0.4s"
    >
      <a
        href="#services"
        class="bg-ink text-surface px-8 py-[15px] rounded-xl font-body font-semibold text-[0.95rem] no-underline shadow-soft hover:bg-ink2 hover:-translate-y-0.5 hover:shadow-card transition-all inline-block"
        data-i18n="hero.cta1"
      >
        Our Services
      </a>
      <a
        href="#contact"
        class="bg-transparent text-ink px-8 py-[15px] rounded-xl border-[1.5px] border-line font-body font-semibold text-[0.95rem] no-underline hover:border-blue hover:text-blue hover:-translate-y-0.5 transition-all inline-block"
        data-i18n="hero.cta2"
      >
        Contact Us
      </a>
    </div>

    <div
      class="flex gap-2.5 flex-wrap mt-12 opacity-0 animate-up"
      style="animation-delay: 0.5s"
    >
      <div class="bg-surface border border-line rounded-full px-4 py-2 text-[0.82rem] font-medium text-ink2 flex items-center gap-2 hover:border-blue hover:-translate-y-0.5 transition-all">
        <span class="w-[7px] h-[7px] rounded-full bg-blue inline-block shadow-[0_0_0_3px_var(--color-blue-light)]"></span>
        <span data-i18n="pill.1">Renewable Solar Energy</span>
      </div>
      <div class="bg-surface border border-line rounded-full px-4 py-2 text-[0.82rem] font-medium text-ink2 flex items-center gap-2 hover:border-blue hover:-translate-y-0.5 transition-all">
        <span class="w-[7px] h-[7px] rounded-full bg-blue inline-block shadow-[0_0_0_3px_var(--color-blue-light)]"></span>
        <span data-i18n="pill.2">Digital Services</span>
      </div>
      <div class="bg-surface border border-line rounded-full px-4 py-2 text-[0.82rem] font-medium text-ink2 flex items-center gap-2 hover:border-blue hover:-translate-y-0.5 transition-all">
        <span class="w-[7px] h-[7px] rounded-full bg-blue inline-block shadow-[0_0_0_3px_var(--color-blue-light)]"></span>
        <span data-i18n="pill.3">Home Appliances &amp; Goods</span>
      </div>
      <div class="bg-surface border border-line rounded-full px-4 py-2 text-[0.82rem] font-medium text-ink2 flex items-center gap-2 hover:border-blue hover:-translate-y-0.5 transition-all">
        <span class="w-[7px] h-[7px] rounded-full bg-blue inline-block shadow-[0_0_0_3px_var(--color-blue-light)]"></span>
        <span data-i18n="pill.4">Customer Support</span>
      </div>
    </div>
  </div>

  <HeroCards />
</section>
