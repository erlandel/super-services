---
import ContactInfo from './ContactInfo.astro';
import ContactForm from './ContactForm.astro';
---

<section id="contact" class="px-[6%] py-[100px] bg-bg transition-[background] duration-350">
  <div class="text-center max-w-[500px] mx-auto mb-[52px] rv">
    <div class="text-[0.75rem] font-semibold tracking-[2.5px] uppercase text-blue mb-3" data-i18n="contact.label">
      Contact
    </div>
    <h2 class="font-display text-[clamp(1.9rem,3.5vw,2.8rem)] font-bold text-ink tracking-[-0.5px]" data-i18n="contact.title">
      Let's Work Together
    </h2>
    <p class="text-muted text-base leading-[1.7] mt-2.5 mx-auto" data-i18n="contact.sub">
      Visit us in Alexandria or send us a message — we're ready to help.
    </p>
  </div>

  <div class="grid grid-cols-[5fr_7fr] gap-14 bg-surface border border-line rounded-2xl px-[52px] py-14 shadow-soft max-md:grid-cols-1 max-md:px-7 max-md:py-9 max-md:gap-8 rv">
    <ContactInfo />
    <ContactForm />
  </div>
</section>
