---
import ServiceCard from './ServiceCard.astro';
---

<section id="services" class="px-[6%] py-25 bg-bg transition-[background] duration-350 ">
  <div class="mb-13 rv">
    <div class="text-[0.75rem] font-semibold tracking-[2.5px] uppercase text-blue mb-3" data-i18n="svc.label">
      What We Offer
    </div>
    <h2 class="font-display text-[clamp(1.9rem,3.5vw,2.8rem)] font-bold text-ink tracking-[-0.5px]" data-i18n="svc.title">
      Built for Convenience
    </h2>
    <p class="text-muted text-xl leading-[1.7] mt-2.5 " data-i18n="svc.sub">
      Four core services designed to make your day easier — all under one roof.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 place-items-center   ">
    <div class="rv flex">
      <ServiceCard
        image="/images/energy.webp"
        title="Renewable Solar Energy"
        desc="Professional solar panel installation and guidance, with support at every step toward your energy independence."
        i18nTitle="svc.1.t"
        i18nDesc="svc.1.d"
      />
    </div>
    <div class="rv flex">
      <ServiceCard
        image="/images/Digital.webp"
        title="Digital Services"
        desc="Modern digital solutions for your everyday needs. From online transactions to document processing, we keep you connected and productive."
        i18nTitle="svc.2.t"
        i18nDesc="svc.2.d"
      />
    </div>
    <div class="rv flex">
      <ServiceCard
        image="/images/Ventas.webp"
        title="Home Appliances &amp; Goods"
        desc="Upgrade your living spaces with our premium selection of home appliances and essentials. Enjoy reliable quality, fast delivery, and full warranty protection."
        i18nTitle="svc.3.t"
        i18nDesc="svc.3.d"
      />
    </div>
    <div class="rv flex">
      <ServiceCard
        image="/images/Soporte.webp"
        title="Customer Support &amp; Processing"
        desc="Personalized guidance and administrative help. Our team walks you through every step, making complex tasks simple."
        i18nTitle="svc.4.t"
        i18nDesc="svc.4.d"
      />
    </div>
  </div>
</section>
