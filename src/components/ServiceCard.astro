---
export interface Props {
  image: string;
  title: string;
  desc: string;
  i18nTitle: string;
  i18nDesc: string;
}

const { image, title, desc, i18nTitle, i18nDesc } = Astro.props;
---

<div class="w-full h-full flex flex-col bg-surface border border-line rounded-2xl overflow-hidden transition-all duration-250 hover:border-blue hover:shadow-card hover:-translate-y-1 hover:shadow-blue-2xl max-w-3xl">
  <img src={image} alt={title} class="w-full h-auto sm:h-80 object-cover" />
  <div class="p-6 flex flex-col flex-1">
  <h3
    class="font-display text-xl font-bold text-ink mb-2.5"
    data-i18n={i18nTitle}
  >
    {title}
  </h3>
  <p
    class="sm:text-lg leading-[1.65] text-muted"
    data-i18n={i18nDesc}
  >
    {desc}
  </p>
  </div>
</div>
